# Copy this file to .env and fill in real values. docker-compose.yml loads it
# automatically (env_file: .env); config.yml references these via ${VAR}
# interpolation (see src/pdf2anki/config.py's `${ENV_VAR}` support).

# ---- LLM provider ----
# Set the key for whichever provider config.yml's pipeline.llm.provider names
# (openai or anthropic). Only the one you use needs a real value.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Generic alias some deployments prefer to standardize on - point config.yml's
# pipeline.llm.api_key at ${API_KEY} instead of a provider-specific var if you'd
# rather manage one secret regardless of provider.
API_KEY=

# ---- Notifications ----
# Slack incoming webhook URL (https://api.slack.com/messaging/webhooks).
# Referenced by config.yml's service.notifications.slack_webhook_url.
SLACK_WEBHOOK_URL=

# ---- Mount directory overrides ----
# Host paths bind-mounted into the container by docker-compose.yml. Point
# these at your actual Readwise export sync folder and PDF/textbook drop
# folders. Defaults below assume everything lives under ./data next to this
# file - change to wherever your real sync directories are.
PDF_SYNC_DIR=./data/pdfs
TEXTBOOK_SYNC_DIR=./data/textbooks
READWISE_SYNC_DIR=./data/readwise

# Where the running .apkg/cards.csv/manifest.json/coverage reports persist on
# the host, across container restarts.
WORKSPACE_DIR=./data/workspace

# Persistent storage for the bundled `anki` service's Anki2 profile/collection
# (docker-compose.yml) - survives container restarts/rebuilds. This is where
# your AnkiWeb login and the actual Anki collection live.
ANKI_DATA_DIR=./data/anki

# Per-textbook instructions.yml files, one subdirectory per book (see
# src/pdf2anki/textbook.py:load_textbook_profile()). Optional - books without
# their own instructions.yml fall back to examples/textbook_default.yml.
TEXTBOOK_CONFIGS_DIR=./data/textbook-configs
